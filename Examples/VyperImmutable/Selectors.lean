import Ethereum.Semantics

/-!
# Immutable selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Examples.VyperImmutable

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev immutableSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (3 entries). -/
def immutableSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x57, 0xde, 0x26, 0xa4]⟩  -- read()
  | 1 => ⟨#[0x5f, 0x33, 0x64, 0xc9]⟩  -- matches_limit(uint256)
  | _ => ⟨#[0x8d, 0xa5, 0xcb, 0x5b]⟩  -- owner()

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("read()")[0:4] = 0x57de26a4`. -/
theorem readSelectorFact :
    (Ethereum.KEC (String.toByteArray "read()")).extract 0 4 = immutableSelBytes 0 := by
  decide +kernel

/-- `keccak256("matches_limit(uint256)")[0:4] = 0x5f3364c9`. -/
theorem matches_limitSelectorFact :
    (Ethereum.KEC (String.toByteArray "matches_limit(uint256)")).extract 0 4 = immutableSelBytes 1 := by
  decide +kernel

/-- `keccak256("owner()")[0:4] = 0x8da5cb5b`. -/
theorem ownerSelectorFact :
    (Ethereum.KEC (String.toByteArray "owner()")).extract 0 4 = immutableSelBytes 2 := by
  decide +kernel

end Examples.VyperImmutable
