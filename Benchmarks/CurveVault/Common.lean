open Solm ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Benchmarks.CurveVault

set_option maxRecDepth 2000000

/-- Initial address words in slots 0..4 are canonical, so the address getters
return their full raw words. No string-length, mapping noncollision, or post-call
storage assumption is made. The controller's raw word is retained separately
when it is re-read and passed to transferFrom; see HANDOFF.md. -/
def storageWF : StorageWF := fun σ I =>
  ∀ slot : Nat, slot < 5 →
    (((σ.get? I.codeOwner).getD default).storage.getD
      (UInt256.ofNat slot) (UInt256.ofNat 0)).toNat < 2 ^ 160

@[simp] theorem vaultBytecode_size : vaultBytecode.size = 8635 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [withdraw_uint256_addressTransition, withdraw_uint256Transition, withdraw_uint256_address_addressTransition, totalAssetsTransition, nameTransition, convertToAssetsTransition, approveTransition, previewWithdrawTransition, totalSupplyTransition, transferFromTransition, collateral_tokenTransition, pricePerShare_boolTransition, pricePerShare_Transition, ammTransition, decimalsTransition, assetTransition, increaseAllowanceTransition, maxDepositTransition, previewRedeemTransition, deposit_uint256_addressTransition, deposit_uint256Transition, balanceOfTransition, borrowed_tokenTransition, redeem_uint256_addressTransition, redeem_uint256_address_addressTransition, redeem_uint256Transition, set_max_supplyTransition, mint_uint256_addressTransition, mint_uint256Transition, symbolTransition, decreaseAllowanceTransition, transferTransition, lend_aprTransition, previewMintTransition, borrow_aprTransition, factoryTransition, maxMintTransition, convertToSharesTransition, maxWithdrawTransition, maxSupplyTransition, maxRedeemTransition, allowanceTransition, previewDepositTransition, controllerTransition, adminTransition, initializeTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

