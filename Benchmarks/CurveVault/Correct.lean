/-- Whole-contract refinement under `storageWF` (no gas bound); no immutables, so the deployed
code is the constant runtime and the restricted immutables are empty. -/
theorem vaultContractCorrect :
    contractRefinementWF storageWF noGasBound config vaultCreationBytecode contract :=
  .of_runtime vaultConstructorCorrect (fun imms _ => by
    rw [restrictImmutables_noImmutables (by rfl)]
    exact vaultCorrect)

