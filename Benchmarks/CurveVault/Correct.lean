/-!
# Vault correctness capstone (generated by `scripts/proof_skeleton.py`, Vyper)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Solm ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Benchmarks.CurveVault

set_option maxRecDepth 2000000

theorem vaultNoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = vaultBytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 46 → (vaultSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (vaultX_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (vaultDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (vaultX_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (vaultDispatch_none_short hshort)

