  refine ⟨fun σ σ₀ g A I hcode hsize hwf _ ↦ ?_⟩
  by_cases h0 : selIs I (vaultSelBytes 0)
  · exact vaultWithdraw_uint256_addressBody hwf hcode hsize h0
  · by_cases h1 : selIs I (vaultSelBytes 1)
    · exact vaultWithdraw_uint256Body hwf hcode hsize h1
    · by_cases h2 : selIs I (vaultSelBytes 2)
      · exact vaultWithdraw_uint256_address_addressBody hwf hcode hsize h2
      · by_cases h3 : selIs I (vaultSelBytes 3)
        · exact vaultTotalAssetsBody hwf hcode hsize h3
        · by_cases h4 : selIs I (vaultSelBytes 4)
          · exact vaultNameBody hwf hcode hsize h4
