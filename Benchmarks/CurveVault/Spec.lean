/-! ## Storage backend: Vyper's full-word layout for static declarations.
For DynArray, Bytes, or String state, replace this with vyperBoundedStorage!
and source-checked VyperStorageDecl capacities. -/

private abbrev u256 : VyperStorageType := .elem (.int (.uint ⟨256, by decide⟩))

-- Slots and capacities from Vault.storage.json and the pinned source.
def storageDecls : List VyperStorageDecl :=
  [{ name := "_borrowed_token", ty := .elem .address },
   { name := "_collateral_token", ty := .elem .address },
   { name := "_amm", ty := .elem .address },
   { name := "_controller", ty := u256 },
   { name := "_factory", ty := .elem .address },
   { name := "maxSupply", ty := u256 },
   { name := "name", ty := .string 64 },
   { name := "symbol", ty := .string 34 },
   { name := "allowance", ty := .mapping .address (.mapping .address u256) },
   { name := "balanceOf", ty := .mapping .address u256 },
   { name := "totalSupply", ty := u256 },
   { name := "precision", ty := u256 }]

def boundedStorage : StorageBackend := vyperBoundedStorage! [storageDecls]

/-- String assignments retain the compiler's observable padding in storage.
The richer write value is `(logical length, encoded data words)`; reads remain
ordinary string values. This records storage bytes without a memory model. -/
def storageBackend : StorageBackend :=
  { boundedStorage with
    write := fun er ty value evm =>
      match value with
      | .tuple [.int size, .bytes data] => do
          let capacity ← match er.base, er.steps with
            | "name", [] => .ok 64
            | "symbol", [] => .ok 34
            | _, _ => .error .storageError
          if size < 0 || capacity < size.toNat || data.size != 64 then .revert else do
            let slot := Ethereum.UInt256.ofNat (if er.base == "name" then 6 else 9)
            let evm := EVM.storageStore evm evm.executionEnv.codeOwner slot
              (Ethereum.UInt256.ofNat size.toNat)
            pure (vyperWriteDataWords evm slot data 0 ((size.toNat + 31) / 32))
      | .int word =>
          -- initialize is the only direct writer and its argument is a validated address.
          -- Mapping writes retain all 256 bits, including if their slot aliases slot 3.
          if er.base == "_controller" && er.steps.isEmpty && (word < 0 || word ≥ 2^160) then
            .revert
          else boundedStorage.write er ty value evm
      | _ => boundedStorage.write er ty value evm }

-- Only one full uint256 word is used: no packing, mappings, or byte arrays.
def transientBackend : StorageBackend :=
  solidityTransientStorageBackend (vyperLayout! [contract.transient])

/-! ## External-call ABI (from the translator's call facts; check against the callee ABIs) -/

def selectorBytes (a b c d : UInt8) : ByteArray := ⟨#[a, b, c, d]⟩

/-- `initialize` copies at most 96 return bytes and bounds the string at 32.
Retain the full data word because dirty padding is observable in later SSTOREs.
Offsets are relative to the ABI result, not to an EVM memory address. -/
def decodeTokenSymbol (out : ByteArray) : Option (List Value) := do
  let copied := out.extract 0 96
  let offset ← ABI.readNat? copied.toList 0
  let size ← ABI.readNat? copied.toList offset
  if size > 32 || offset + 32 + size > copied.size then none else
    some [.struct "EncodedSymbol"
      [("size", .int size), ("data", .fixedBytes ⟨31, by decide⟩
        (copied.readWithPadding (offset + 32) 32).toList)]]

def externalABI : ExternalCallABI where
  encode? := fun name args =>
    if False then none
    else if name = "decimals" then  -- decimals()
      ABI.encodeCallWithSelector? (selectorBytes 0x31 0x3c 0xe5 0x67) [] args
    else if name = "symbol" then  -- symbol()
      ABI.encodeCallWithSelector? (selectorBytes 0x95 0xd8 0x9b 0x41) [] args
    else if name = "admin" then  -- admin()
      ABI.encodeCallWithSelector? (selectorBytes 0xf8 0x51 0xa4 0x40) [] args
    else if name = "rate" then  -- rate()
      ABI.encodeCallWithSelector? (selectorBytes 0x2c 0x4e 0x72 0x2e) [] args
    else if name = "total_debt" then  -- total_debt()
      ABI.encodeCallWithSelector? (selectorBytes 0x31 0xdc 0x3c 0xa8) [] args
    else if name = "save_rate" then  -- save_rate()
      ABI.encodeCallWithSelector? (selectorBytes 0x69 0xc6 0x80 0x4e) [] args
    else if name = "available_balance" then  -- available_balance()
      ABI.encodeCallWithSelector? (selectorBytes 0x09 0x23 0x14 0xda) [] args
    else if name = "admin_fees" then  -- admin_fees()
      ABI.encodeCallWithSelector? (selectorBytes 0x1b 0x18 0x00 0xe3) [] args
    else if name = "admin_percentage" then
      ABI.encodeCallWithSelector? (selectorBytes 0x10 0x59 0xfc 0xbd) [] args
    else if name = "on_borrowed_token_transfer_in" then
      ABI.encodeCallWithSelector? (selectorBytes 0xa4 0xa8 0x70 0x22) [(.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "on_borrowed_token_transfer_out" then
      ABI.encodeCallWithSelector? (selectorBytes 0x3f 0x88 0x86 0x81) [(.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "transferFrom" then  -- transferFrom(address,address,uint256)
      -- The compiler passes cached controller words without cleaning their high bits.
      -- Encode the two address words verbatim; the call target itself is still truncated.
      ABI.encodeCallWithSelector? (selectorBytes 0x23 0xb8 0x72 0xdd)
        (List.replicate 3 (.elem (.int (.uint ⟨256, by decide⟩)))) args
    else none
  decode? := fun name out =>
    if False then none
    else if name = "decimals" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨8, by decide⟩))) out).map (fun v => [v])
    else if name = "symbol" then
      decodeTokenSymbol out
    else if name = "admin" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem .address) out).map (fun v => [v])
    else if name = "rate" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "total_debt" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "save_rate" then some []
    else if name = "available_balance" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "admin_fees" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "admin_percentage" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "on_borrowed_token_transfer_in" || name = "on_borrowed_token_transfer_out" then some []
    else if name = "transferFrom" then
      (ABI.decodeReturnValueWithMode? DecodeMode.vyper (.elem .bool) out).map (fun v => [v])
    else none

-- If an entry parameter has a Vyper capacity (DynArray, Bytes, String),
-- declare every selector variant as ABI.VyperABIFunction and use
-- withVyperABI functions here; ABI JSON erases capacities.

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    transientBackend := transientBackend
    externalABI := externalABI.withMode DecodeMode.vyper
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end Benchmarks.CurveVault
