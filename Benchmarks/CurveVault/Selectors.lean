  | 19 => ⟨#[0x6e, 0x55, 0x3f, 0x65]⟩  -- deposit(uint256,address)
  | 20 => ⟨#[0xb6, 0xb5, 0x5f, 0x25]⟩  -- deposit(uint256)
  | 21 => ⟨#[0x70, 0xa0, 0x82, 0x31]⟩  -- balanceOf(address)
  | 22 => ⟨#[0x76, 0x53, 0x37, 0xb6]⟩  -- borrowed_token()
  | 23 => ⟨#[0x7b, 0xde, 0x82, 0xf2]⟩  -- redeem(uint256,address)
  | 24 => ⟨#[0xba, 0x08, 0x76, 0x52]⟩  -- redeem(uint256,address,address)
  | 25 => ⟨#[0xdb, 0x00, 0x6a, 0x75]⟩  -- redeem(uint256)
  | 26 => ⟨#[0x8a, 0x93, 0x8f, 0x2f]⟩  -- set_max_supply(uint256)
  | 27 => ⟨#[0x94, 0xbf, 0x80, 0x4d]⟩  -- mint(uint256,address)
