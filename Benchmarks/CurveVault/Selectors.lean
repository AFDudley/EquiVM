  | 31 => ⟨#[0xa9, 0x05, 0x9c, 0xbb]⟩  -- transfer(address,uint256)
  | 32 => ⟨#[0xa9, 0x80, 0x49, 0x7e]⟩  -- lend_apr()
  | 33 => ⟨#[0xb3, 0xd7, 0xf6, 0xb9]⟩  -- previewMint(uint256)
  | 34 => ⟨#[0xba, 0xc4, 0xda, 0xa2]⟩  -- borrow_apr()
  | 35 => ⟨#[0xc4, 0x5a, 0x01, 0x55]⟩  -- factory()
  | 36 => ⟨#[0xc6, 0x3d, 0x75, 0xb6]⟩  -- maxMint(address)
