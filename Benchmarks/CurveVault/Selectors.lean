  | 14 => ⟨#[0x31, 0x3c, 0xe5, 0x67]⟩  -- decimals()
  | 15 => ⟨#[0x38, 0xd5, 0x2e, 0x0f]⟩  -- asset()
  | 16 => ⟨#[0x39, 0x50, 0x93, 0x51]⟩  -- increaseAllowance(address,uint256)
  | 17 => ⟨#[0x40, 0x2d, 0x26, 0x7d]⟩  -- maxDeposit(address)
