theorem vyperVaultDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [availableSelectorOf]; rfl
  · rw [setPausedSelectorOf]; rfl
  · rw [balancesSelectorOf]; rfl
  · rw [withdrawSelectorOf]; rfl
  · rw [pausedSelectorOf]; rfl
  · rw [totalDepositsSelectorOf]; rfl
  · rw [ownerSelectorOf]; rfl
  · rw [collectFeesSelectorOf]; rfl
  · rw [depositSelectorOf]; rfl
  · rw [feesCollectedSelectorOf]; rfl

theorem vyperVaultDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 10 → (vyperVaultSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [availableSelectorOf]; exact hnm 0 (by omega)
  · rw [setPausedSelectorOf]; exact hnm 1 (by omega)
  · rw [balancesSelectorOf]; exact hnm 2 (by omega)
  · rw [withdrawSelectorOf]; exact hnm 3 (by omega)
  · rw [pausedSelectorOf]; exact hnm 4 (by omega)
  · rw [totalDepositsSelectorOf]; exact hnm 5 (by omega)
  · rw [ownerSelectorOf]; exact hnm 6 (by omega)
  · rw [collectFeesSelectorOf]; exact hnm 7 (by omega)
  · rw [depositSelectorOf]; exact hnm 8 (by omega)
  · rw [feesCollectedSelectorOf]; exact hnm 9 (by omega)

/-! ## The computed dispatcher: `selector % 11` indexes 11 two-byte entries at code offset 1407 -/

/-- Memory after the table lookup of bucket `m`: the entry's two bytes at offset 30. -/
def vyperVaultDispatchMem (m : Nat) : ByteArray := vyperVaultBytecode.write (1407 + 2 * m) ByteArray.empty 30 2

/-- The lookup lands bucket `m` at the entry it names. -/
theorem vyperVaultBucket {σ σ₀ A I} {g : Sat256} {suffix : ByteArray} (m : Nat) (entry : UInt256)
    (hcode : I.code = (vyperVaultBytecode ++ suffix)) (hm : (solcSelectorWord I).toNat % 11 = m)
    (hload : memLoad ⟨0⟩ (vyperVaultDispatchMem m) = entry)
    (hvalid : (D_J vyperVaultBytecode 0).contains entry = true) :
    ∃ k C, RD (vyperVaultBytecode ++ suffix) I g (initState σ σ₀ g A I) entry
      [solcSelectorWord I] (vyperVaultDispatchMem m) (UInt256.ofNat 1) ByteArray.empty σ k C := by
  have hmlt : m < 11 := by rw [← hm]; exact Nat.mod_lt _ (by decide)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have hoff : ((UInt256.ofNat 1407) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 11)) (UInt256.ofNat 1))).toNat = 1407 + 2 * m :=
    offset_toNat (mod_eq_ofNat (by decide) (by decide) hm) (lt_of_lt_of_le (by omega : 1407 + 2 * m < 1430) (by decide))
  have hmem : (vyperVaultBytecode ++ suffix).write ((UInt256.ofNat 1407) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 11)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = vyperVaultDispatchMem m := by
    rw [hoff, ulit_toNat' 30 (by decide), ulit_toNat' 2 (by decide)]
    exact write_append_left_empty _ _ _ _ _ (by decide) (by rw [vyperVaultBytecode_size]; omega)
  have hmem' : (vyperVaultBytecode ++ suffix).write ((UInt256.ofNat 1407) + (UInt256.shiftLeft (UInt256.mod (UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224)) (UInt256.ofNat 11)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = vyperVaultDispatchMem m := hmem
  have haw : M (M (UInt256.ofNat 0) (UInt256.ofNat 30) (UInt256.ofNat 2)) (⟨0⟩ : UInt256) (⟨32⟩ : UInt256) =
      UInt256.ofNat 1 := by decide
  have rd1 := vyperVaultBlocks.vyperVault_block_0 (suffix := suffix) (R := []) (mem := ByteArray.empty)
    (aw := UInt256.ofNat 0) (by simp)
    (by
      show (D_J (vyperVaultBytecode ++ suffix) 0).contains (memLoad ⟨0⟩ ((vyperVaultBytecode ++ suffix).write ((UInt256.ofNat 1407) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 11)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat)) = true
      rw [hmem, hload]
      exact D_J_contains_append_left _ _ _ hvalid) rd0
  simp only [vyperVaultBlocks.vyperVault_block_0_stack, vyperVaultBlocks.vyperVault_block_0_memory] at rd1
  rw [hmem', hload, haw] at rd1
  exact ⟨_, _, rd1⟩

/-- Bucket 0 enters at pc 1399. -/
theorem vyperVaultBucket0 {σ σ₀ A I} {g : Sat256} {suffix : ByteArray}
    (hcode : I.code = (vyperVaultBytecode ++ suffix)) (hm : (solcSelectorWord I).toNat % 11 = 0) :
    ∃ k C, RD (vyperVaultBytecode ++ suffix) I g (initState σ σ₀ g A I) (UInt256.ofNat 1399)
      [solcSelectorWord I] (vyperVaultDispatchMem 0) (UInt256.ofNat 1) ByteArray.empty σ k C :=
  vyperVaultBucket 0 (UInt256.ofNat 1399) hcode hm (by native_decide) (by native_decide)

