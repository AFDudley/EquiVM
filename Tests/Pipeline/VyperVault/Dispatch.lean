/-!
# VyperVault dispatcher (generated by `scripts/proof_skeleton.py`, Vyper)

Stele-side dispatch facts and the runtime dispatcher reach lemmas: the jump-table lookup of
each bucket (`…Bucket`), then the selector-compare chain of the bucket down to the function's
guard block or to the no-match revert, composed from the block summaries.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Tests.Pipeline.VyperVault

set_option maxRecDepth 2000000

/-! ## Stele dispatch: which transition a selector reaches -/

theorem vyperVaultDispatch_available {I : ExecutionEnv} 
    (hsel : selIs I (vyperVaultSelBytes 0)) :
    dispatchMsg contract I.calldata = some availableTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [setPausedTransition, balancesTransition, withdrawTransition, pausedTransition, totalDepositsTransition, ownerTransition, collectFeesTransition, depositTransition, feesCollectedTransition])
    (ti := availableTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [availableSelectorOf]; exact hsel

theorem vyperVaultDispatch_setPaused {I : ExecutionEnv} (h0 : ¬ selIs I (vyperVaultSelBytes 0))
    (hsel : selIs I (vyperVaultSelBytes 1)) :
    dispatchMsg contract I.calldata = some setPausedTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [availableTransition]) (post := [balancesTransition, withdrawTransition, pausedTransition, totalDepositsTransition, ownerTransition, collectFeesTransition, depositTransition, feesCollectedTransition])
    (ti := setPausedTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [availableSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [setPausedSelectorOf]; exact hsel

