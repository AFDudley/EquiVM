/-! ## Immutables: the deployed runtime is the template plus the words of the store -/

/-- A well-typed immutables store deploys the template with its words as the code suffix,
the form the block summaries state the code in (the Vyper analogue of
`restrictImmutables_of_fit`). -/
theorem deployed_of_fit {imms : Store} (h : immutablesFit contract imms) :
    immutableLayout.deployed vyperVaultBytecode imms =
      vyperVaultBytecode ++ immutableLayout.suffixWords (wordsOf imms) := by
  obtain ⟨v, hget, hfits⟩ := h ⟨"OWNER", .address⟩ (by decide)
  cases v <;> simp [elemValueFits] at hfits
  rename_i a
  show deployedRuntime imms = _
  exact deployedRuntime_eq_words imms (.address a) (UInt256.toByteArray (EVM.Word.ofNat a.toNat)) hget
    (by simp [scalarBytes?, valueToWord]) (toByteArray_size _)

