/-! ## Selector words as the dispatcher compares them -/

theorem availableEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨269060821⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (vyperVaultSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x10 0x09 0x8a 0xd5 ⟨269060821⟩ (by decide)

