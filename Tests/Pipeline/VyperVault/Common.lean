@[simp] theorem vyperVaultBytecode_size : vyperVaultBytecode.size = 1429 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [availableTransition, setPausedTransition, balancesTransition, withdrawTransition, pausedTransition, totalDepositsTransition, ownerTransition, collectFeesTransition, depositTransition, feesCollectedTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf availableTransition = vyperVaultSelBytes 0` (`available(address)`). -/
theorem availableSelectorOf : selectorOf availableTransition = vyperVaultSelBytes 0 := by
  have hsig : transitionSigStr availableTransition = "available(address)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, availableTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact availableSelectorFact

