import Tests.Pipeline.VyperVault.Constructor
import Tests.Pipeline.VyperVault.Available
import Tests.Pipeline.VyperVault.SetPaused
import Tests.Pipeline.VyperVault.Balances
import Tests.Pipeline.VyperVault.Withdraw
import Tests.Pipeline.VyperVault.Paused
import Tests.Pipeline.VyperVault.TotalDeposits
import Tests.Pipeline.VyperVault.Owner
import Tests.Pipeline.VyperVault.CollectFees
import Tests.Pipeline.VyperVault.Deposit
import Tests.Pipeline.VyperVault.FeesCollected
import Stele.Refine

/-!
# VyperVault correctness capstone (generated by `scripts/proof_skeleton.py`, Vyper)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch
open Reasoning.VyperImmutables

namespace Tests.Pipeline.VyperVault

set_option maxRecDepth 2000000

theorem vyperVaultNoDispatch {σ σ₀ A I} {g : UInt256} (imms : Store) (hfit : immutablesFit contract imms)
    (hcode : I.code = immutableLayout.deployed vyperVaultBytecode imms) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 10 → (vyperVaultSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I (restrictImmutables contract imms) := by
  have hcode' : I.code = vyperVaultBytecode ++ immutableLayout.suffixWords (wordsOf imms) := by
    rw [hcode, deployed_of_fit hfit]
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (vyperVaultX_noMatch (g := Sat256.ofUInt256 g) hcode' hsz hsize hnm)
      |>.reEquivNoDispatch hcode' (vyperVaultDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (vyperVaultX_short (g := Sat256.ofUInt256 g) hcode' hshort)
      |>.reEquivNoDispatch hcode' (vyperVaultDispatch_none_short hshort)

theorem vyperVaultNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (vyperVaultSelBytes 0)) (h1 : ¬ selIs I (vyperVaultSelBytes 1)) (h2 : ¬ selIs I (vyperVaultSelBytes 2)) (h3 : ¬ selIs I (vyperVaultSelBytes 3)) (h4 : ¬ selIs I (vyperVaultSelBytes 4)) (h5 : ¬ selIs I (vyperVaultSelBytes 5)) (h6 : ¬ selIs I (vyperVaultSelBytes 6)) (h7 : ¬ selIs I (vyperVaultSelBytes 7)) (h8 : ¬ selIs I (vyperVaultSelBytes 8)) (h9 : ¬ selIs I (vyperVaultSelBytes 9)) :
    ∀ i, i < 10 → (vyperVaultSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5
  · simpa [selIs] using h6
  · simpa [selIs] using h7
  · simpa [selIs] using h8
  · simpa [selIs] using h9

/-- Runtime refinement under the typed-storage precondition `storageWF` (the `paused` slot holds a
`bool` word): Vyper returns and compares raw storage words, so the spec's `bool` view of slot 4 is
the bytecode's word only for `0`/`1`.  `setPaused` is the only writer and stores a validated word. -/
theorem vyperVaultCorrect (imms : Store) (hfit : immutablesFit contract imms) :
    runtimeRefinementWithWF storageWF noGasBound config (immutableLayout.deployed vyperVaultBytecode imms) contract
      (restrictImmutables contract imms) := by
  refine ⟨fun σ σ₀ g A I hcode hsize hwf _ ↦ ?_⟩
  by_cases h0 : selIs I (vyperVaultSelBytes 0)
  · exact vyperVaultAvailableBody imms hfit hwf hcode hsize h0
  · by_cases h1 : selIs I (vyperVaultSelBytes 1)
    · exact vyperVaultSetPausedBody imms hfit hwf hcode hsize h1
    · by_cases h2 : selIs I (vyperVaultSelBytes 2)
      · exact vyperVaultBalancesBody imms hfit hwf hcode hsize h2
      · by_cases h3 : selIs I (vyperVaultSelBytes 3)
        · exact vyperVaultWithdrawBody imms hfit hwf hcode hsize h3
        · by_cases h4 : selIs I (vyperVaultSelBytes 4)
          · exact vyperVaultPausedBody imms hfit hwf hcode hsize h4
          · by_cases h5 : selIs I (vyperVaultSelBytes 5)
            · exact vyperVaultTotalDepositsBody imms hfit hwf hcode hsize h5
            · by_cases h6 : selIs I (vyperVaultSelBytes 6)
              · exact vyperVaultOwnerBody imms hfit hwf hcode hsize h6
              · by_cases h7 : selIs I (vyperVaultSelBytes 7)
                · exact vyperVaultCollectFeesBody imms hfit hwf hcode hsize h7
                · by_cases h8 : selIs I (vyperVaultSelBytes 8)
                  · exact vyperVaultDepositBody imms hfit hwf hcode hsize h8
                  · by_cases h9 : selIs I (vyperVaultSelBytes 9)
                    · exact vyperVaultFeesCollectedBody imms hfit hwf hcode hsize h9
                    · exact vyperVaultNoDispatch imms hfit hcode hsize (vyperVaultNoSelectorMatches h0 h1 h2 h3 h4 h5 h6 h7 h8 h9)

/-- Whole-contract refinement under `storageWF` (no gas bound). -/
theorem vyperVaultContractCorrect :
    contractRefinementWF storageWF noGasBound config vyperVaultCreationBytecode contract :=
  .of_runtime vyperVaultConstructorCorrect vyperVaultCorrect

end Tests.Pipeline.VyperVault
