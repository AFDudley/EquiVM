/-- `keccak256("feesCollected()")[0:4] = 0xf071db5a`. -/
theorem feesCollectedSelectorFact :
    (Ethereum.KEC (String.toByteArray "feesCollected()")).extract 0 4 = vyperVaultSelBytes 9 := by
  decide +kernel

end Tests.Pipeline.VyperVault
