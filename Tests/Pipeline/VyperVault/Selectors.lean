import Ethereum.Semantics

/-!
# VyperVault selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Tests.Pipeline.VyperVault

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev vyperVaultSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (10 entries). -/
def vyperVaultSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x10, 0x09, 0x8a, 0xd5]⟩  -- available(address)
  | 1 => ⟨#[0x16, 0xc3, 0x8b, 0x3c]⟩  -- setPaused(bool)
  | 2 => ⟨#[0x27, 0xe2, 0x35, 0xe3]⟩  -- balances(address)
  | 3 => ⟨#[0x2e, 0x1a, 0x7d, 0x4d]⟩  -- withdraw(uint256)
  | 4 => ⟨#[0x5c, 0x97, 0x5a, 0xbb]⟩  -- paused()
  | 5 => ⟨#[0x7d, 0x88, 0x20, 0x97]⟩  -- totalDeposits()
  | 6 => ⟨#[0x8d, 0xa5, 0xcb, 0x5b]⟩  -- owner()
  | 7 => ⟨#[0xc8, 0x79, 0x65, 0x72]⟩  -- collectFees()
  | 8 => ⟨#[0xd0, 0xe3, 0x0d, 0xb0]⟩  -- deposit()
  | _ => ⟨#[0xf0, 0x71, 0xdb, 0x5a]⟩  -- feesCollected()

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("available(address)")[0:4] = 0x10098ad5`. -/
theorem availableSelectorFact :
    (Ethereum.KEC (String.toByteArray "available(address)")).extract 0 4 = vyperVaultSelBytes 0 := by
  decide +kernel

/-- `keccak256("setPaused(bool)")[0:4] = 0x16c38b3c`. -/
theorem setPausedSelectorFact :
    (Ethereum.KEC (String.toByteArray "setPaused(bool)")).extract 0 4 = vyperVaultSelBytes 1 := by
  decide +kernel

/-- `keccak256("balances(address)")[0:4] = 0x27e235e3`. -/
theorem balancesSelectorFact :
    (Ethereum.KEC (String.toByteArray "balances(address)")).extract 0 4 = vyperVaultSelBytes 2 := by
  decide +kernel

/-- `keccak256("withdraw(uint256)")[0:4] = 0x2e1a7d4d`. -/
theorem withdrawSelectorFact :
    (Ethereum.KEC (String.toByteArray "withdraw(uint256)")).extract 0 4 = vyperVaultSelBytes 3 := by
  decide +kernel

/-- `keccak256("paused()")[0:4] = 0x5c975abb`. -/
theorem pausedSelectorFact :
    (Ethereum.KEC (String.toByteArray "paused()")).extract 0 4 = vyperVaultSelBytes 4 := by
  decide +kernel

/-- `keccak256("totalDeposits()")[0:4] = 0x7d882097`. -/
theorem totalDepositsSelectorFact :
    (Ethereum.KEC (String.toByteArray "totalDeposits()")).extract 0 4 = vyperVaultSelBytes 5 := by
  decide +kernel

/-- `keccak256("owner()")[0:4] = 0x8da5cb5b`. -/
theorem ownerSelectorFact :
    (Ethereum.KEC (String.toByteArray "owner()")).extract 0 4 = vyperVaultSelBytes 6 := by
