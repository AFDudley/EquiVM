  ((Tests.Pipeline.VyperVault.vyperVaultBytecode ++ suffix).write ((UInt256.ofNat 1407) + (UInt256.shiftLeft (UInt256.mod (UInt256.shiftRight (uInt256OfByteArray (ee.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224)) (UInt256.ofNat 11)) (UInt256.ofNat 1))).toNat mem (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat)

