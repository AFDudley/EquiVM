import Tests.Pipeline.VyperVault.SpecSyntax
import Solm.Semantics
import Solm.SolidityLayout
import Solm.MetaVyperLayout
import Solm.Refine

import Tests.Pipeline.VyperVault.Immutables
/-!
# VyperVault spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (Vyper layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Solm ABI

namespace Tests.Pipeline.VyperVault

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev availableTransition : TransitionDecl := contract.transitions[0]!  -- available(address)
abbrev setPausedTransition : TransitionDecl := contract.transitions[1]!  -- setPaused(bool)
abbrev balancesTransition : TransitionDecl := contract.transitions[2]!  -- balances(address)
abbrev withdrawTransition : TransitionDecl := contract.transitions[3]!  -- withdraw(uint256)
abbrev pausedTransition : TransitionDecl := contract.transitions[4]!  -- paused()
abbrev totalDepositsTransition : TransitionDecl := contract.transitions[5]!  -- totalDeposits()
abbrev ownerTransition : TransitionDecl := contract.transitions[6]!  -- owner()
abbrev collectFeesTransition : TransitionDecl := contract.transitions[7]!  -- collectFees()
abbrev depositTransition : TransitionDecl := contract.transitions[8]!  -- deposit()
abbrev feesCollectedTransition : TransitionDecl := contract.transitions[9]!  -- feesCollected()

/-! ## Storage backend: Vyper's full-word layout for static declarations.
For DynArray, Bytes, or String state, replace this with vyperBoundedStorage!
and source-checked VyperStorageDecl capacities. -/

def storageBackend : StorageBackend := vyperStorage! [contract.storage]

-- If an entry parameter has a Vyper capacity (DynArray, Bytes, String),
-- declare every selector variant as ABI.VyperABIFunction and use
-- withVyperABI functions here; ABI JSON erases capacities.

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI.withMode DecodeMode.vyper
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end Tests.Pipeline.VyperVault
