import Stele.DiffTest.Harness
import Tests.Pipeline.VyperWrapper.Spec
import Tests.Pipeline.VyperWrapper.Bytecode
import Tests.Pipeline.VyperWrapper.ImmutableCode

/-!
# Wrapper differential-test target (generated by `scripts/scaffold.py difftest`)

Registered in `Tests/DiffTest/Generated.lean`; run with `lake exe stele-difftest --only Wrapper`.
Adjust `callees` and `words` when the contract needs specific counterparties or amounts.
-/

open Stele Stele.DiffTest

namespace Tests.Pipeline.VyperWrapper

/-- The `TOKEN` immutable fixed to the standard callee that answers every call with the word 1
(`transferFrom`/`transfer` return `true`, `balanceOf` returns 1), so that `wrap` and `unwrap`
reach their success paths; a generated constructor run would pick a random token address. -/
def immutablesWithToken : Store :=
  (initialImmutables contract).insert "TOKEN" (.address (EVM.address 0x5000))

def diffTarget : Target :=
  { name := "VyperWrapper", contract := contract, config := config,
    runtime := immutableLayout.deployed wrapperBytecode immutablesWithToken,
    initcode := some wrapperCreationBytecode,
    immutables := immutablesWithToken,
    runtimeCodeOf := some (immutableLayout.deployed wrapperBytecode),
    callees := standardCallees, words := [10 ^ 18, 1, 2] }

end Tests.Pipeline.VyperWrapper
