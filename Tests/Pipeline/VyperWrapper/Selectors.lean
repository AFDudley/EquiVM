import Ethereum.Semantics

/-!
# Wrapper selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Solm transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Tests.Pipeline.VyperWrapper

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev wrapperSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (8 entries). -/
def wrapperSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x3a, 0x98, 0xef, 0x39]⟩  -- totalShares()
  | 1 => ⟨#[0x3d, 0xfd, 0x38, 0x73]⟩  -- setHook(address)
  | 2 => ⟨#[0x7f, 0x5a, 0x7c, 0x7b]⟩  -- hook()
  | 3 => ⟨#[0xaa, 0x9b, 0x07, 0x4e]⟩  -- previewUnwrap(uint256)
  | 4 => ⟨#[0xce, 0x7c, 0x2a, 0xc2]⟩  -- shares(address)
  | 5 => ⟨#[0xde, 0x0e, 0x9a, 0x3e]⟩  -- unwrap(uint256)
  | 6 => ⟨#[0xea, 0x59, 0x8c, 0xb0]⟩  -- wrap(uint256)
  | _ => ⟨#[0xfc, 0x0c, 0x54, 0x6a]⟩  -- token()

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("totalShares()")[0:4] = 0x3a98ef39`. -/
theorem totalSharesSelectorFact :
    (Ethereum.KEC (String.toByteArray "totalShares()")).extract 0 4 = wrapperSelBytes 0 := by
  decide +kernel

/-- `keccak256("setHook(address)")[0:4] = 0x3dfd3873`. -/
theorem setHookSelectorFact :
    (Ethereum.KEC (String.toByteArray "setHook(address)")).extract 0 4 = wrapperSelBytes 1 := by
  decide +kernel

/-- `keccak256("hook()")[0:4] = 0x7f5a7c7b`. -/
theorem hookSelectorFact :
    (Ethereum.KEC (String.toByteArray "hook()")).extract 0 4 = wrapperSelBytes 2 := by
  decide +kernel

/-- `keccak256("previewUnwrap(uint256)")[0:4] = 0xaa9b074e`. -/
theorem previewUnwrapSelectorFact :
    (Ethereum.KEC (String.toByteArray "previewUnwrap(uint256)")).extract 0 4 = wrapperSelBytes 3 := by
  decide +kernel

/-- `keccak256("shares(address)")[0:4] = 0xce7c2ac2`. -/
theorem sharesSelectorFact :
    (Ethereum.KEC (String.toByteArray "shares(address)")).extract 0 4 = wrapperSelBytes 4 := by
  decide +kernel

/-- `keccak256("unwrap(uint256)")[0:4] = 0xde0e9a3e`. -/
theorem unwrapSelectorFact :
    (Ethereum.KEC (String.toByteArray "unwrap(uint256)")).extract 0 4 = wrapperSelBytes 5 := by
  decide +kernel

/-- `keccak256("wrap(uint256)")[0:4] = 0xea598cb0`. -/
theorem wrapSelectorFact :
    (Ethereum.KEC (String.toByteArray "wrap(uint256)")).extract 0 4 = wrapperSelBytes 6 := by
  decide +kernel

/-- `keccak256("token()")[0:4] = 0xfc0c546a`. -/
theorem tokenSelectorFact :
    (Ethereum.KEC (String.toByteArray "token()")).extract 0 4 = wrapperSelBytes 7 := by
  decide +kernel

end Tests.Pipeline.VyperWrapper
