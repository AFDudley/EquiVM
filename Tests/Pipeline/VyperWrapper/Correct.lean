import Tests.Pipeline.VyperWrapper.Constructor
import Tests.Pipeline.VyperWrapper.TotalShares
import Tests.Pipeline.VyperWrapper.SetHook
import Tests.Pipeline.VyperWrapper.Hook
import Tests.Pipeline.VyperWrapper.PreviewUnwrap
import Tests.Pipeline.VyperWrapper.Shares
import Tests.Pipeline.VyperWrapper.Unwrap
import Tests.Pipeline.VyperWrapper.Wrap
import Tests.Pipeline.VyperWrapper.Token
import Stele.Refine

/-!
# Wrapper correctness capstone (generated by `scripts/proof_skeleton.py`, Vyper)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch
open Reasoning.VyperImmutables

namespace Tests.Pipeline.VyperWrapper

set_option maxRecDepth 2000000

theorem wrapperNoDispatch {σ σ₀ A I} {g : UInt256} (imms : Store) (hfit : immutablesFit contract imms)
    (hcode : I.code = immutableLayout.deployed wrapperBytecode imms) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 8 → (wrapperSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I (restrictImmutables contract imms) := by
  have hcode' : I.code = wrapperBytecode ++ immutableLayout.suffixWords (wordsOf imms) := by
    rw [hcode, deployed_of_fit hfit]
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (wrapperX_noMatch (g := Sat256.ofUInt256 g) hcode' hsz hsize hnm)
      |>.reEquivNoDispatch hcode' (wrapperDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (wrapperX_short (g := Sat256.ofUInt256 g) hcode' hshort)
      |>.reEquivNoDispatch hcode' (wrapperDispatch_none_short hshort)

theorem wrapperNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (wrapperSelBytes 0)) (h1 : ¬ selIs I (wrapperSelBytes 1)) (h2 : ¬ selIs I (wrapperSelBytes 2)) (h3 : ¬ selIs I (wrapperSelBytes 3)) (h4 : ¬ selIs I (wrapperSelBytes 4)) (h5 : ¬ selIs I (wrapperSelBytes 5)) (h6 : ¬ selIs I (wrapperSelBytes 6)) (h7 : ¬ selIs I (wrapperSelBytes 7)) :
    ∀ i, i < 8 → (wrapperSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5
  · simpa [selIs] using h6
  · simpa [selIs] using h7

/-- Runtime refinement under the typed-storage precondition `storageWF` (`Helpers.lean`): the
`hook` word is a canonical address, the caller's `shares` slot is not slot 0, and `hook` stays
canonical across the message calls `wrap` makes.  Vyper returns and compares raw storage words,
so the spec's `address` view of `hook` is the bytecode's word only under these facts; `setHook`,
the only writer, stores a validated word. -/
theorem wrapperCorrect (imms : Store) (hfit : immutablesFit contract imms) :
    runtimeRefinementWithWF storageWF noGasBound config (immutableLayout.deployed wrapperBytecode imms) contract
      (restrictImmutables contract imms) := by
  refine ⟨fun σ σ₀ g A I hcode hsize hwf _ ↦ ?_⟩
  by_cases h0 : selIs I (wrapperSelBytes 0)
  · exact wrapperTotalSharesBody imms hfit hwf hcode hsize h0
  · by_cases h1 : selIs I (wrapperSelBytes 1)
    · exact wrapperSetHookBody imms hfit hwf hcode hsize h1
    · by_cases h2 : selIs I (wrapperSelBytes 2)
      · exact wrapperHookBody imms hfit hwf hcode hsize h2
      · by_cases h3 : selIs I (wrapperSelBytes 3)
        · exact wrapperPreviewUnwrapBody imms hfit hwf hcode hsize h3
        · by_cases h4 : selIs I (wrapperSelBytes 4)
          · exact wrapperSharesBody imms hfit hwf hcode hsize h4
          · by_cases h5 : selIs I (wrapperSelBytes 5)
            · exact wrapperUnwrapBody imms hfit hwf hcode hsize h5
            · by_cases h6 : selIs I (wrapperSelBytes 6)
              · exact wrapperWrapBody imms hfit hwf hcode hsize h6
              · by_cases h7 : selIs I (wrapperSelBytes 7)
                · exact wrapperTokenBody imms hfit hwf hcode hsize h7
                · exact wrapperNoDispatch imms hfit hcode hsize (wrapperNoSelectorMatches h0 h1 h2 h3 h4 h5 h6 h7)

/-- Whole-contract refinement under `storageWF` (no gas bound). -/
theorem wrapperContractCorrect :
    contractRefinementWF storageWF noGasBound config wrapperCreationBytecode contract :=
  .of_runtime wrapperConstructorCorrect wrapperCorrect

end Tests.Pipeline.VyperWrapper
