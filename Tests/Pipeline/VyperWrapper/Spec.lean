import Tests.Pipeline.VyperWrapper.SpecSyntax
import Stele.Semantics
import Stele.SolidityLayout
import Stele.MetaVyperLayout
import Stele.Refine

import Tests.Pipeline.VyperWrapper.Immutables
/-!
# Wrapper spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (Vyper layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Stele ABI

namespace Tests.Pipeline.VyperWrapper

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev totalSharesTransition : TransitionDecl := contract.transitions[0]!  -- totalShares()
abbrev setHookTransition : TransitionDecl := contract.transitions[1]!  -- setHook(address)
abbrev hookTransition : TransitionDecl := contract.transitions[2]!  -- hook()
abbrev previewUnwrapTransition : TransitionDecl := contract.transitions[3]!  -- previewUnwrap(uint256)
abbrev sharesTransition : TransitionDecl := contract.transitions[4]!  -- shares(address)
abbrev unwrapTransition : TransitionDecl := contract.transitions[5]!  -- unwrap(uint256)
abbrev wrapTransition : TransitionDecl := contract.transitions[6]!  -- wrap(uint256)
abbrev tokenTransition : TransitionDecl := contract.transitions[7]!  -- token()

/-! ## Storage backend: Vyper's full-word layout for static declarations.
For DynArray, Bytes, or String state, replace this with vyperBoundedStorage!
and source-checked VyperStorageDecl capacities. -/

def storageBackend : StorageBackend := vyperStorage! [contract.storage]

/-! ## External-call ABI (from the translator's call facts; check against the callee ABIs) -/

def selectorBytes (a b c d : UInt8) : ByteArray := ⟨#[a, b, c, d]⟩

def externalABI : ExternalCallABI where
  encode? := fun name args =>
    if False then none
    else if name = "transferFrom" then  -- transferFrom(address,address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0x23 0xb8 0x72 0xdd) [(.elem .address), (.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "balanceOf" then  -- balanceOf(address)
      ABI.encodeCallWithSelector? (selectorBytes 0x70 0xa0 0x82 0x31) [(.elem .address)] args
    else if name = "onWrap" then  -- onWrap(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0xa2 0x33 0x56 0xfa) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "transfer" then  -- transfer(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0xa9 0x05 0x9c 0xbb) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else none
  decode? := fun name out =>
    if False then none
    else if name = "transferFrom" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem .bool) out).map (fun v => [v])
    else if name = "balanceOf" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "onWrap" then some []
    else if name = "transfer" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem .bool) out).map (fun v => [v])
    else none

-- If an entry parameter has a Vyper capacity (DynArray, Bytes, String),
-- declare every selector variant as ABI.VyperABIFunction and use
-- withVyperABI functions here; ABI JSON erases capacities.

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := externalABI.withMode DecodeMode.vyper
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end Tests.Pipeline.VyperWrapper
