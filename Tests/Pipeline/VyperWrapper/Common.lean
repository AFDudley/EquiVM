/-! ## Selector words as the dispatcher compares them -/

theorem totalSharesEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨983101241⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (wrapperSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x3a 0x98 0xef 0x39 ⟨983101241⟩ (by decide)

