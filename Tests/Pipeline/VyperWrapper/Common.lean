set_option maxRecDepth 2000000

@[simp] theorem wrapperBytecode_size : wrapperBytecode.size = 1780 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [totalSharesTransition, setHookTransition, hookTransition, previewUnwrapTransition, sharesTransition, unwrapTransition, wrapTransition, tokenTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf totalSharesTransition = wrapperSelBytes 0` (`totalShares()`). -/
theorem totalSharesSelectorOf : selectorOf totalSharesTransition = wrapperSelBytes 0 := by
  have hsig : transitionSigStr totalSharesTransition = "totalShares()" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, totalSharesTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact totalSharesSelectorFact

