/-! ## Solm dispatch: which transition a selector reaches -/

theorem wrapperDispatch_totalShares {I : ExecutionEnv} 
    (hsel : selIs I (wrapperSelBytes 0)) :
    dispatchMsg contract I.calldata = some totalSharesTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [setHookTransition, hookTransition, previewUnwrapTransition, sharesTransition, unwrapTransition, wrapTransition, tokenTransition])
    (ti := totalSharesTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [totalSharesSelectorOf]; exact hsel

theorem wrapperDispatch_setHook {I : ExecutionEnv} (h0 : ¬ selIs I (wrapperSelBytes 0))
    (hsel : selIs I (wrapperSelBytes 1)) :
    dispatchMsg contract I.calldata = some setHookTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [totalSharesTransition]) (post := [hookTransition, previewUnwrapTransition, sharesTransition, unwrapTransition, wrapTransition, tokenTransition])
    (ti := setHookTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [totalSharesSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [setHookSelectorOf]; exact hsel

