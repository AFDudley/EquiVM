theorem wrapperDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [totalSharesSelectorOf]; rfl
  · rw [setHookSelectorOf]; rfl
  · rw [hookSelectorOf]; rfl
  · rw [previewUnwrapSelectorOf]; rfl
  · rw [sharesSelectorOf]; rfl
  · rw [unwrapSelectorOf]; rfl
  · rw [wrapSelectorOf]; rfl
  · rw [tokenSelectorOf]; rfl

theorem wrapperDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 8 → (wrapperSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [totalSharesSelectorOf]; exact hnm 0 (by omega)
  · rw [setHookSelectorOf]; exact hnm 1 (by omega)
  · rw [hookSelectorOf]; exact hnm 2 (by omega)
  · rw [previewUnwrapSelectorOf]; exact hnm 3 (by omega)
  · rw [sharesSelectorOf]; exact hnm 4 (by omega)
  · rw [unwrapSelectorOf]; exact hnm 5 (by omega)
  · rw [wrapSelectorOf]; exact hnm 6 (by omega)
  · rw [tokenSelectorOf]; exact hnm 7 (by omega)

/-! ## The computed dispatcher: `selector & 7` indexes 8 two-byte entries at code offset 1764 -/

/-- Memory after the table lookup of bucket `m`: the entry's two bytes at offset 30. -/
def wrapperDispatchMem (m : Nat) : ByteArray := wrapperBytecode.write (1764 + 2 * m) ByteArray.empty 30 2

/-- The lookup lands bucket `m` at the entry it names. -/
theorem wrapperBucket {σ σ₀ A I} {g : Sat256} {suffix : ByteArray} (m : Nat) (entry : UInt256)
    (hcode : I.code = (wrapperBytecode ++ suffix)) (hm : (solcSelectorWord I).toNat % 8 = m)
    (hload : memLoad ⟨0⟩ (wrapperDispatchMem m) = entry)
    (hvalid : (D_J wrapperBytecode 0).contains entry = true) :
    ∃ k C, RD (wrapperBytecode ++ suffix) I g (initState σ σ₀ g A I) entry
      [solcSelectorWord I] (wrapperDispatchMem m) (UInt256.ofNat 1) ByteArray.empty σ k C := by
  have hmlt : m < 8 := by rw [← hm]; exact Nat.mod_lt _ (by decide)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have hoff : ((UInt256.ofNat 1764) + (UInt256.shiftLeft (UInt256.land (solcSelectorWord I) (UInt256.ofNat 7)) (UInt256.ofNat 1))).toNat = 1764 + 2 * m :=
    offset_toNat (land_eq_ofNat (mask := 7) (b := 3) (n := 8) (by norm_num) (by norm_num) (by decide) hm) (lt_of_lt_of_le (by omega : 1764 + 2 * m < 1781) (by decide))
  have hmem : (wrapperBytecode ++ suffix).write ((UInt256.ofNat 1764) + (UInt256.shiftLeft (UInt256.land (solcSelectorWord I) (UInt256.ofNat 7)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = wrapperDispatchMem m := by
    rw [hoff, ulit_toNat' 30 (by decide), ulit_toNat' 2 (by decide)]
    exact write_append_left_empty _ _ _ _ _ (by decide) (by rw [wrapperBytecode_size]; omega)
  have hmem' : (wrapperBytecode ++ suffix).write ((UInt256.ofNat 1764) + (UInt256.shiftLeft (UInt256.land (UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224)) (UInt256.ofNat 7)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = wrapperDispatchMem m := hmem
  have haw : M (M (UInt256.ofNat 0) (UInt256.ofNat 30) (UInt256.ofNat 2)) (⟨0⟩ : UInt256) (⟨32⟩ : UInt256) =
      UInt256.ofNat 1 := by decide
  have rd1 := wrapperBlocks.wrapper_block_0 (suffix := suffix) (R := []) (mem := ByteArray.empty)
    (aw := UInt256.ofNat 0) (by simp)
    (by
      show (D_J (wrapperBytecode ++ suffix) 0).contains (memLoad ⟨0⟩ ((wrapperBytecode ++ suffix).write ((UInt256.ofNat 1764) + (UInt256.shiftLeft (UInt256.land (solcSelectorWord I) (UInt256.ofNat 7)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat)) = true
      rw [hmem, hload]
      exact D_J_contains_append_left _ _ _ hvalid) rd0
  simp only [wrapperBlocks.wrapper_block_0_stack, wrapperBlocks.wrapper_block_0_memory] at rd1
  rw [hmem', hload, haw] at rd1
  exact ⟨_, _, rd1⟩

