import Tests.Pipeline.VyperRegistry.SpecSyntax
import Stele.Semantics
import Stele.SolidityLayout
import Stele.MetaVyperLayout
import Stele.Refine

/-!
# Registry spec assembly (generated by `scripts/proof_skeleton.py`)

The contract is defined by `SpecSyntax.lean`; this file only names its parts: the transition
handles the proof files unfold, the storage backend (Vyper layout, from the
declarations), the external-call ABI, and the `Config`.
-/

open Stele ABI

namespace Tests.Pipeline.VyperRegistry

def contract : ContractDecl := Syntax.contractSyntax

/-! ## Transition handles, in `contract.transitions` order -/

abbrev countTransition : TransitionDecl := contract.transitions[0]!  -- count()
abbrev active_weightTransition : TransitionDecl := contract.transitions[1]!  -- active_weight()
abbrev register_addressTransition : TransitionDecl := contract.transitions[2]!  -- register(address)
abbrev register_address_uint256Transition : TransitionDecl := contract.transitions[3]!  -- register(address,uint256)
abbrev nextIdTransition : TransitionDecl := contract.transitions[4]!  -- nextId()
abbrev ownerTransition : TransitionDecl := contract.transitions[5]!  -- owner()
abbrev deactivateTransition : TransitionDecl := contract.transitions[6]!  -- deactivate(uint256)
abbrev totalWeightTransition : TransitionDecl := contract.transitions[7]!  -- totalWeight()
abbrev entriesTransition : TransitionDecl := contract.transitions[8]!  -- entries(uint256)
abbrev pop_lastTransition : TransitionDecl := contract.transitions[9]!  -- pop_last()
abbrev transfer_ownershipTransition : TransitionDecl := contract.transitions[10]!  -- transfer_ownership(address)
abbrev idsTransition : TransitionDecl := contract.transitions[11]!  -- ids(uint256)

/-! ## Storage backend: Vyper's inline layout with the source capacities.

`ids` is `DynArray[uint256, MAX_ENTRIES]` with `MAX_ENTRIES = 16` (`Registry.vy`), so the
declarations carry that capacity; the other declarations are the static ones of
`SpecSyntax.lean` in the order of `Registry.storage.json` (slots 0, 1, 2–18, 19, 20). -/

private abbrev u256 : VyperStorageType := .elem (.int (.uint ⟨256, by decide⟩))

def storageDecls : List VyperStorageDecl :=
  [{ name := "ownable_owner", ty := .elem .address },
   { name := "entries", ty := .mapping (.int (.uint ⟨256, by decide⟩))
       (.struct "Entry" [("account", .elem .address), ("weight", u256), ("active", .elem .bool)]) },
   { name := "ids", ty := .dynamicArray u256 16 },
   { name := "nextId", ty := u256 },
   { name := "totalWeight", ty := u256 }]

def storageBackend : StorageBackend := vyperBoundedStorage! [storageDecls]

-- If an entry parameter has a Vyper capacity (DynArray, Bytes, String),
-- declare every selector variant as ABI.VyperABIFunction and use
-- withVyperABI functions here; ABI JSON erases capacities.

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := defaultExternalCallABI.withMode DecodeMode.vyper
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

end Tests.Pipeline.VyperRegistry
