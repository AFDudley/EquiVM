import Ethereum.Semantics

/-!
# Registry selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Tests.Pipeline.VyperRegistry

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev registrySelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (12 entries). -/
def registrySelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x06, 0x66, 0x1a, 0xbd]⟩  -- count()
  | 1 => ⟨#[0x27, 0xa3, 0x7a, 0xe6]⟩  -- active_weight()
  | 2 => ⟨#[0x44, 0x20, 0xe4, 0x86]⟩  -- register(address)
  | 3 => ⟨#[0x6d, 0x70, 0x5e, 0xbb]⟩  -- register(address,uint256)
  | 4 => ⟨#[0x61, 0xb8, 0xce, 0x8c]⟩  -- nextId()
  | 5 => ⟨#[0x8d, 0xa5, 0xcb, 0x5b]⟩  -- owner()
  | 6 => ⟨#[0x91, 0x6b, 0x9b, 0xef]⟩  -- deactivate(uint256)
  | 7 => ⟨#[0x96, 0xc8, 0x2e, 0x57]⟩  -- totalWeight()
  | 8 => ⟨#[0xb3, 0x09, 0x06, 0xd4]⟩  -- entries(uint256)
  | 9 => ⟨#[0xef, 0xfd, 0xfd, 0x55]⟩  -- pop_last()
  | 10 => ⟨#[0xf0, 0x35, 0x0c, 0x04]⟩  -- transfer_ownership(address)
  | _ => ⟨#[0xfa, 0xc3, 0x33, 0xac]⟩  -- ids(uint256)

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("count()")[0:4] = 0x06661abd`. -/
theorem countSelectorFact :
    (Ethereum.KEC (String.toByteArray "count()")).extract 0 4 = registrySelBytes 0 := by
  decide +kernel

/-- `keccak256("active_weight()")[0:4] = 0x27a37ae6`. -/
theorem active_weightSelectorFact :
    (Ethereum.KEC (String.toByteArray "active_weight()")).extract 0 4 = registrySelBytes 1 := by
  decide +kernel

