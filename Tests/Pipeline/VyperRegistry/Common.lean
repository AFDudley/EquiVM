open Solm ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Tests.Pipeline.VyperRegistry

set_option maxRecDepth 2000000

@[simp] theorem registryBytecode_size : registryBytecode.size = 1685 := by
  native_decide +revert

/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [countTransition, active_weightTransition, register_addressTransition, register_address_uint256Transition, nextIdTransition, ownerTransition, deactivateTransition, totalWeightTransition, entriesTransition, pop_lastTransition, transfer_ownershipTransition, idsTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf countTransition = registrySelBytes 0` (`count()`). -/
theorem countSelectorOf : selectorOf countTransition = registrySelBytes 0 := by
  have hsig : transitionSigStr countTransition = "count()" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, countTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact countSelectorFact

