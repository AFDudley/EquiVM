import Tests.Pipeline.VyperRegistry.Constructor
import Tests.Pipeline.VyperRegistry.Count
import Tests.Pipeline.VyperRegistry.Active_weight
import Tests.Pipeline.VyperRegistry.Register_address
import Tests.Pipeline.VyperRegistry.Register_address_uint256
import Tests.Pipeline.VyperRegistry.NextId
import Tests.Pipeline.VyperRegistry.Owner
import Tests.Pipeline.VyperRegistry.Deactivate
import Tests.Pipeline.VyperRegistry.TotalWeight
import Tests.Pipeline.VyperRegistry.Entries
import Tests.Pipeline.VyperRegistry.Pop_last
import Tests.Pipeline.VyperRegistry.Transfer_ownership
import Tests.Pipeline.VyperRegistry.Ids
import Solm.Refine

/-!
# Registry correctness capstone (generated by `scripts/proof_skeleton.py`, Vyper)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Solm ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Tests.Pipeline.VyperRegistry

set_option maxRecDepth 2000000

theorem registryNoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = registryBytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 12 → (registrySelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (registryX_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (registryDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (registryX_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (registryDispatch_none_short hshort)

theorem registryNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (registrySelBytes 0)) (h1 : ¬ selIs I (registrySelBytes 1)) (h2 : ¬ selIs I (registrySelBytes 2)) (h3 : ¬ selIs I (registrySelBytes 3)) (h4 : ¬ selIs I (registrySelBytes 4)) (h5 : ¬ selIs I (registrySelBytes 5)) (h6 : ¬ selIs I (registrySelBytes 6)) (h7 : ¬ selIs I (registrySelBytes 7)) (h8 : ¬ selIs I (registrySelBytes 8)) (h9 : ¬ selIs I (registrySelBytes 9)) (h10 : ¬ selIs I (registrySelBytes 10)) (h11 : ¬ selIs I (registrySelBytes 11)) :
    ∀ i, i < 12 → (registrySelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5
  · simpa [selIs] using h6
  · simpa [selIs] using h7
  · simpa [selIs] using h8
  · simpa [selIs] using h9
  · simpa [selIs] using h10
  · simpa [selIs] using h11

/-- Runtime refinement under the typed-storage precondition `storageWF` (`Helpers.lean`): the owner
word is a canonical address, the `ids` length is within its capacity, every `entries[id]` holds a
canonical account and a `bool` word, and the struct slots of `entries[nextId]` are not the `ids`
length slot (the hash non-collision `register` needs).  Vyper returns and compares raw storage
words, so the spec's typed view of storage is the bytecode's word only under these facts; every
writer stores validated words, so the precondition is preserved. -/
theorem registryCorrect :
    runtimeRefinementWithWF storageWF noGasBound config registryBytecode contract := by
  refine ⟨fun σ σ₀ g A I hcode hsize hwf _ ↦ ?_⟩
  by_cases h0 : selIs I (registrySelBytes 0)
  · exact registryCountBody hwf hcode hsize h0
  · by_cases h1 : selIs I (registrySelBytes 1)
    · exact registryActive_weightBody hwf hcode hsize h1
    · by_cases h2 : selIs I (registrySelBytes 2)
      · exact registryRegister_addressBody hwf hcode hsize h2
      · by_cases h3 : selIs I (registrySelBytes 3)
        · exact registryRegister_address_uint256Body hwf hcode hsize h3
        · by_cases h4 : selIs I (registrySelBytes 4)
          · exact registryNextIdBody hwf hcode hsize h4
          · by_cases h5 : selIs I (registrySelBytes 5)
            · exact registryOwnerBody hwf hcode hsize h5
            · by_cases h6 : selIs I (registrySelBytes 6)
              · exact registryDeactivateBody hwf hcode hsize h6
              · by_cases h7 : selIs I (registrySelBytes 7)
                · exact registryTotalWeightBody hwf hcode hsize h7
                · by_cases h8 : selIs I (registrySelBytes 8)
                  · exact registryEntriesBody hwf hcode hsize h8
                  · by_cases h9 : selIs I (registrySelBytes 9)
                    · exact registryPop_lastBody hwf hcode hsize h9
                    · by_cases h10 : selIs I (registrySelBytes 10)
                      · exact registryTransfer_ownershipBody hwf hcode hsize h10
                      · by_cases h11 : selIs I (registrySelBytes 11)
                        · exact registryIdsBody hwf hcode hsize h11
                        · exact registryNoDispatch hcode hsize (registryNoSelectorMatches h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11)

/-- Whole-contract refinement under `storageWF` (no gas bound).  The contract has no immutables, so
the deployed code is the constant `registryBytecode` and the restricted immutables are empty. -/
theorem registryContractCorrect :
    contractRefinementWF storageWF noGasBound config registryCreationBytecode contract :=
  .of_runtime registryConstructorCorrect (fun imms _ => by
    rw [restrictImmutables_noImmutables (by rfl)]
    exact registryCorrect)

end Tests.Pipeline.VyperRegistry
