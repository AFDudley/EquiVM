/-!
# Registry dispatcher (generated by `scripts/proof_skeleton.py`, Vyper)

Stele-side dispatch facts and the runtime dispatcher reach lemmas: the jump-table lookup of
each bucket (`…Bucket`), then the selector-compare chain of the bucket down to the function's
guard block or to the no-match revert, composed from the block summaries.
-/

open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach Reasoning.VyperDispatch

namespace Tests.Pipeline.VyperRegistry

set_option maxRecDepth 2000000

/-! ## Stele dispatch: which transition a selector reaches -/

theorem registryDispatch_count {I : ExecutionEnv} 
    (hsel : selIs I (registrySelBytes 0)) :
    dispatchMsg contract I.calldata = some countTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [active_weightTransition, register_addressTransition, register_address_uint256Transition, nextIdTransition, ownerTransition, deactivateTransition, totalWeightTransition, entriesTransition, pop_lastTransition, transfer_ownershipTransition, idsTransition])
    (ti := countTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [countSelectorOf]; exact hsel

theorem registryDispatch_active_weight {I : ExecutionEnv} (h0 : ¬ selIs I (registrySelBytes 0))
    (hsel : selIs I (registrySelBytes 1)) :
    dispatchMsg contract I.calldata = some active_weightTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [countTransition]) (post := [register_addressTransition, register_address_uint256Transition, nextIdTransition, ownerTransition, deactivateTransition, totalWeightTransition, entriesTransition, pop_lastTransition, transfer_ownershipTransition, idsTransition])
    (ti := active_weightTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [countSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [active_weightSelectorOf]; exact hsel

