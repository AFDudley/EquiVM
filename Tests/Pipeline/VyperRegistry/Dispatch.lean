theorem registryDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [countSelectorOf]; rfl
  · rw [active_weightSelectorOf]; rfl
  · rw [register_addressSelectorOf]; rfl
  · rw [register_address_uint256SelectorOf]; rfl
  · rw [nextIdSelectorOf]; rfl
  · rw [ownerSelectorOf]; rfl
  · rw [deactivateSelectorOf]; rfl
  · rw [totalWeightSelectorOf]; rfl
  · rw [entriesSelectorOf]; rfl
  · rw [pop_lastSelectorOf]; rfl
  · rw [transfer_ownershipSelectorOf]; rfl
  · rw [idsSelectorOf]; rfl

theorem registryDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 12 → (registrySelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [countSelectorOf]; exact hnm 0 (by omega)
  · rw [active_weightSelectorOf]; exact hnm 1 (by omega)
  · rw [register_addressSelectorOf]; exact hnm 2 (by omega)
  · rw [register_address_uint256SelectorOf]; exact hnm 3 (by omega)
  · rw [nextIdSelectorOf]; exact hnm 4 (by omega)
  · rw [ownerSelectorOf]; exact hnm 5 (by omega)
  · rw [deactivateSelectorOf]; exact hnm 6 (by omega)
  · rw [totalWeightSelectorOf]; exact hnm 7 (by omega)
  · rw [entriesSelectorOf]; exact hnm 8 (by omega)
  · rw [pop_lastSelectorOf]; exact hnm 9 (by omega)
  · rw [transfer_ownershipSelectorOf]; exact hnm 10 (by omega)
  · rw [idsSelectorOf]; exact hnm 11 (by omega)

/-! ## The computed dispatcher: `selector % 10` indexes 10 two-byte entries at code offset 1665 -/

/-- Memory after the table lookup of bucket `m`: the entry's two bytes at offset 30. -/
def registryDispatchMem (m : Nat) : ByteArray := registryBytecode.write (1665 + 2 * m) ByteArray.empty 30 2

/-- The lookup lands bucket `m` at the entry it names. -/
theorem registryBucket {σ σ₀ A I} {g : Sat256} (m : Nat) (entry : UInt256)
    (hcode : I.code = registryBytecode) (hm : (solcSelectorWord I).toNat % 10 = m)
    (hload : memLoad ⟨0⟩ (registryDispatchMem m) = entry)
    (hvalid : (D_J registryBytecode 0).contains entry = true) :
    ∃ k C, RD registryBytecode I g (initState σ σ₀ g A I) entry
      [solcSelectorWord I] (registryDispatchMem m) (UInt256.ofNat 1) ByteArray.empty σ k C := by
  have hmlt : m < 10 := by rw [← hm]; exact Nat.mod_lt _ (by decide)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have hoff : ((UInt256.ofNat 1665) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 10)) (UInt256.ofNat 1))).toNat = 1665 + 2 * m :=
    offset_toNat (mod_eq_ofNat (by decide) (by decide) hm) (lt_of_lt_of_le (by omega : 1665 + 2 * m < 1686) (by decide))
  have hmem : registryBytecode.write ((UInt256.ofNat 1665) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 10)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = registryDispatchMem m := by
    rw [hoff, ulit_toNat' 30 (by decide), ulit_toNat' 2 (by decide)]
    rfl
  have hmem' : registryBytecode.write ((UInt256.ofNat 1665) + (UInt256.shiftLeft (UInt256.mod (UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224)) (UInt256.ofNat 10)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat = registryDispatchMem m := hmem
  have haw : M (M (UInt256.ofNat 0) (UInt256.ofNat 30) (UInt256.ofNat 2)) (⟨0⟩ : UInt256) (⟨32⟩ : UInt256) =
      UInt256.ofNat 1 := by decide
  have rd1 := registryBlocks.registry_block_0 (R := []) (mem := ByteArray.empty)
    (aw := UInt256.ofNat 0) (by simp)
    (by
      show (D_J registryBytecode 0).contains (memLoad ⟨0⟩ (registryBytecode.write ((UInt256.ofNat 1665) + (UInt256.shiftLeft (UInt256.mod (solcSelectorWord I) (UInt256.ofNat 10)) (UInt256.ofNat 1))).toNat ByteArray.empty (UInt256.ofNat 30).toNat (UInt256.ofNat 2).toNat)) = true
      rw [hmem, hload]
      exact hvalid) rd0
  simp only [registryBlocks.registry_block_0_stack, registryBlocks.registry_block_0_memory] at rd1
  rw [hmem', hload, haw] at rd1
  exact ⟨_, _, rd1⟩

/-- Bucket 0 enters at pc 1533. -/
theorem registryBucket0 {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = registryBytecode) (hm : (solcSelectorWord I).toNat % 10 = 0) :
    ∃ k C, RD registryBytecode I g (initState σ σ₀ g A I) (UInt256.ofNat 1533)
      [solcSelectorWord I] (registryDispatchMem 0) (UInt256.ofNat 1) ByteArray.empty σ k C :=
  registryBucket 0 (UInt256.ofNat 1533) hcode hm (by native_decide) (by native_decide)

/-- Bucket 1 enters at pc 1123. -/
theorem registryBucket1 {σ σ₀ A I} {g : Sat256}
    (hcode : I.code = registryBytecode) (hm : (solcSelectorWord I).toNat % 10 = 1) :
